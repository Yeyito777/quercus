#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
python="$root/.venv/bin/python"

# Per-machine settings (e.g. QUERCUS_SESSION_FILE on a second install) live in
# the untracked config/local.env, a bash fragment. Absent, the defaults apply.
if [[ -f "$root/config/local.env" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$root/config/local.env"
  set +a
fi

if [[ ! -x "$python" ]]; then
  printf 'quercus: isolated environment is missing\n' >&2
  printf 'Run: uv sync --project %s\n' "$root" >&2
  exit 127
fi

export PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -m quercus_tool.cli "$@"
